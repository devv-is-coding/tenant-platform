# The .env the Docker stack runs with in CI (.github/workflows/stack.yml copies
# it to .env and appends a fresh APP_KEY). Same services as local development
# (compose.yaml): MariaDB, Redis, SeaweedFS for S3. Throwaway values only:
# nothing here is a real secret, and the stack lives for one job.
APP_NAME=DevvStack
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=tenant_platform
DB_USERNAME=tenant_platform
DB_PASSWORD=ci-only-password
DB_ROOT_PASSWORD=ci-only-root-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
AGENCY_FILES_DRIVER=s3
QUEUE_CONNECTION=database
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

AWS_ACCESS_KEY_ID=seaweedfs
AWS_SECRET_ACCESS_KEY=seaweedfs-local
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=agency-files
AWS_ENDPOINT=http://seaweedfs:8333
AWS_URL=http://localhost:8333/agency-files
AWS_USE_PATH_STYLE_ENDPOINT=true

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

COMPOSE_PROFILES=
