# The local load balancer (the `proxy` service in compose.yaml): spreads
# requests across every `app` replica, so the stack runs the way it would on
# several servers. Production puts its own balancer here instead.
{
	admin off
	auto_https off
}

:80 {
	reverse_proxy {
		# Every replica of the `app` service, re-resolved from compose's DNS,
		# so `docker compose up --scale app=3` needs no change here.
		dynamic a {
			name app
			port 80
			refresh 5s
		}

		lb_policy round_robin

		# A replica that errors is skipped for a while, and the request is
		# retried on another, so restarting one node drops no requests.
		fail_duration 10s
		lb_try_duration 5s

		# The original Host is kept (agencies are found by their domain);
		# X-Forwarded-For / -Proto / -Host are added, which the app believes
		# because TRUSTED_PROXIES names this proxy.

		# Development only: which replica answered, to see the balancing.
		header_down X-Served-By {http.reverse_proxy.upstream.hostport}
	}
}
