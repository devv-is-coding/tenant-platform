APP_NAME=DevvStack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# The load balancers whose X-Forwarded-* headers are believed: comma list of
# IPs/CIDRs, or "*". Empty while the app is reachable directly.
TRUSTED_PROXIES=
# Old keys still accepted for decryption after rotating APP_KEY, comma list.
APP_PREVIOUS_KEYS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# In the shared cache, so `php artisan down` takes every node down, not one.
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Agencies' files (gallery, logos) and Livewire's temporary uploads: "s3" (the
# AWS_* bucket below, shared by every node) or "local" (one node only).
AGENCY_FILES_DRIVER=s3
QUEUE_CONNECTION=database

# Must be a store that can tag (redis, memcached, array): tenancy tags every
# cache call with the agency, and refuses to enter an agency on one that cannot.
# With Docker, also set REDIS_HOST=redis (the compose service).
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Local SeaweedFS (compose.yaml), which accepts any key; the SDK still needs
# one, or it goes looking for cloud instance credentials. In production: the
# real bucket's credentials, endpoint and public URL.
AWS_ACCESS_KEY_ID=seaweedfs
AWS_SECRET_ACCESS_KEY=seaweedfs-local
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=agency-files
# The app reaches the bucket inside the compose network; the browser loads
# files from the published port.
AWS_ENDPOINT=http://seaweedfs:8333
AWS_URL=http://localhost:8333/agency-files
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# Stripe, through Cashier: the platform's own account takes every agency's
# online payments. Test-mode keys from the Stripe dashboard; the webhook
# secret from `stripe listen` locally, or the dashboard endpoint in
# production. Without STRIPE_WEBHOOK_SECRET every webhook is refused.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
