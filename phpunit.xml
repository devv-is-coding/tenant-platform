<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            The suite's memory grows with every test (130 MB at ~800 tests), past
            PHP's 128 MB default, so the tests get their own ceiling.
        -->
        <ini name="memory_limit" value="512M"/>
        <!--
            These MUST be <server>, not <env>. docker compose passes .env through
            `env_file`, so DB_CONNECTION and friends exist as real environment
            variables and land in $_SERVER. Laravel's env() reads $_SERVER before
            $_ENV/getenv(), and PHPUnit's <env force="true"> only writes the
            latter two - so <env> alone leaves the suite pointed at the
            development database, where RefreshDatabase wipes it.
        -->
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="DB_CONNECTION" value="sqlite" force="true"/>
        <server name="DB_DATABASE" value=":memory:" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <server name="DB_CACHE_CONNECTION" value="sqlite" force="true"/>
        <server name="DB_QUEUE_CONNECTION" value="sqlite" force="true"/>
        <server name="SESSION_CONNECTION" value="sqlite" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="PULSE_ENABLED" value="false" force="true"/>
        <server name="TELESCOPE_ENABLED" value="false" force="true"/>
        <server name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
